# ─────────────────────────────────────────────────────────────
# Supabase Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# From Supabase Project -> Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# From Supabase Project -> Settings -> API -> Project API keys
# Use the "anon public" key (or "Publishable key" on newer projects)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Web push (notifications on phones and computers). The PUBLIC key made by `node scripts/generate-vapid-keys.mjs` (safe to be seen).
# Leave empty and the "Turn on notifications" control stays hidden (the bell keeps working).
VITE_VAPID_PUBLIC_KEY=

# ── Kagay-anon Bridging Application (/bridging): its OWN Supabase project. Only the public values; never the service_role key. ──
VITE_BRIDGING_SUPABASE_URL=https://your-bridging-project-ref.supabase.co
VITE_BRIDGING_SUPABASE_ANON_KEY=your-bridging-anon-or-publishable-key-here
# optional "I am human" check (Cloudflare Turnstile site key); also switch it on in the Bridging project's Authentication settings
VITE_BRIDGING_TURNSTILE_SITE_KEY=
