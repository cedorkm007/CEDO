# Signing key — a secret, not source. Never commit. Back this up somewhere
# safe outside git (password manager / secure storage): losing it means you
# can never publish an update to this same app listing again.
android.keystore
*.keystore
*.jks

# Build outputs and caches — regenerated by `./gradlew assembleRelease
# bundleRelease`, then zipalign/apksigner/jarsigner per docs/kauban/
# ANDROID_APP.md. Not worth tracking, and the signed artifacts especially
# would just go stale in git.
build/
app/build/
.gradle/
node_modules/
local.properties
*.apk
*.apk.idsig
*.aab
build.log
