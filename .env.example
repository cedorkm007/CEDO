# ─────────────────────────────────────────────────────────────
# Google OAuth & Sheets Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The ID of your Google Spreadsheet (from the URL)
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
VITE_GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# (Optional) Google Drive folder ID where task evidence images will be uploaded
# Leave blank to upload to the root of My Drive
VITE_GOOGLE_DRIVE_FOLDER_ID=

# ── Kagay-anon Bridging Application (/bridging): its OWN Supabase project. Only the public values; never the service_role key. ──
VITE_BRIDGING_SUPABASE_URL=https://your-bridging-project-ref.supabase.co
VITE_BRIDGING_SUPABASE_ANON_KEY=your-bridging-anon-or-publishable-key-here
# optional "I am human" check (Cloudflare Turnstile site key); also switch it on in the Bridging project's Authentication settings
VITE_BRIDGING_TURNSTILE_SITE_KEY=
